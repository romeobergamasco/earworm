# Copy this file to .env (git-ignored) and fill it in. Never commit .env.
# Supabase -> Project Settings -> API Keys (and Data API for the URL).

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Secret key (sb_secret_... or the legacy service_role key): full access, server and indexer only.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_... or the legacy anon key): only used by
# `python -m indexer db-check` to prove that it can read and write NOTHING.
SUPABASE_PUBLISHABLE_KEY=

# MusicBrainz asks for a contact in the User-Agent: put the GitHub repo URL here once it exists.
EARWORM_CONTACT=
